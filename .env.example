# 复制此文件为 .env 并填入你的密钥

# OpenRouter API（https://openrouter.ai/keys）
OPENROUTER_API_KEY=

# 本机加密密钥（证件保险箱 / 对话历史 / 用户档案共用；留空则首次运行自动生成存钥匙串）
MEMORY_ENCRYPTION_KEY=

# 潜客工作流的潜客树文件路径。默认用 jarvis 自己的副本 data/prospect_tree.json
# （跑完会就地标 done 推进，不影响外部数据源）。一般留空即可；仅当想指向别处时设：
# JARVIS_PROSPECT_TREE=

# 工具按域渐进披露：现已默认【开】——每轮只暴露核心常驻工具 + load_tools，
# 其余按领域按需加载（小模型路由更准）。如需回到"每轮全量暴露"的旧行为，
# 取消下面这行注释设为 0：
# JARVIS_PROGRESSIVE_TOOLS=0
