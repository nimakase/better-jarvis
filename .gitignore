# 密钥和环境变量（绝对不要提交）
.env

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.venv/
venv/

# 数据库和用户数据
*.db
*.db-wal
*.db-shm
*.db-journal
# 运行时数据目录（inbox/results/archive、临时文件等，不入库）
data/*
# 例外：潜客树是【人工策划的资产】（12 赛道 × 64 产品类目 + HS 码 + signal_sectors 映射），
# 不是运行时垃圾——必须入库，否则重新 clone 就没了、潜客工作流第一步就挂。
# 注意 status 字段会被 mark_node_done 就地改写，所以它的 diff 里会有推进痕迹，属正常。
!data/prospect_tree.json

# 用户生成的技能和定时任务（包含用户特定配置）
skills/
schedules/

# 本地备份快照（不入库）
better jarvis/
*_backup_*.zip

# 个人档案 / 记忆导出（含真实隐私，绝不入库）
核心记忆导出.txt
用户档案框架.md

# 系统文件
.DS_Store
Thumbs.db

# 浏览器 profile。正确位置在 DATA_DIR/hubspot/chrome_profile（与 app 共用登录态），
# 仓库里出现这个目录说明某个技能又把 base_dir 猜成了仓库根（见 skill_policy 的
# 「profile 目录 · 必读」约定）。忽略它，同时它出现本身就是个信号。
chrome_profile/

# 运行时产物：日志滚动文件、临时导出结果、待清理内容（不入库）
logs/*.log.[0-9]*
Claude outputs/
_to_delete/
workspace/results/*
